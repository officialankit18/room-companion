NODE_ENV=development
PORT=5000

FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://roomcompanion-two.vercel.app
BACKEND_URL=http://localhost:5000

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/room_companion
DNS_SERVERS=8.8.8.8,1.1.1.1

JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d

BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=replace_with_sender_email
BREVO_SENDER_NAME=RoomCompanion

CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

GEMINI_API_KEY=replace_with_gemini_api_key

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RoomCompanion/1.0 (contact: your-email@example.com)
